# Crawler Identity & Politeness
USER_AGENT=GeographicalLeadScraperPOC/1.0 (contact: research@dakini.ai)
REQUEST_DELAY_SECONDS=1.0
MAX_DISCOVERY_RESULTS=10000

# 1. OpenStreetMap Overpass API
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=30
OVERPASS_FALLBACK_URLS=https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter

# 2. Overture Maps (Remote GeoParquet via DuckDB)
OVERTURE_ENABLED=true
OVERTURE_MAX_ROWS=10000
OVERTURE_TIMEOUT_SECONDS=45

# 3. Web Search Discovery (SearXNG Local + Open Web / MediaWiki fallback)
SEARXNG_URL=http://localhost:8080
SEARXNG_MAX_REQUESTS=6
SEARXNG_TIMEOUT_SECONDS=8
SEARXNG_FALLBACK_TO_WEB=true
# Optional SerpApi key
SERPAPI_API_KEY=

# 4. Wikidata Query Service & Web API (Public, no API key required)
WIKIDATA_ENABLED=true
WIKIDATA_MAX_SEARCHES=4
WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql
WIKIDATA_API_URL=https://www.wikidata.org/w/api.php
WIKIDATA_TIMEOUT_SECONDS=10

# 5. India Open Government Data: MCA Company Master Data (Embedded dataset included)
MCA_ENABLED=true
MCA_DATASET_PATH=data/external/company_master_data.csv

# 6. AllThePlaces / Agency Location Discovery (Embedded GeoJSON location dataset included)
ALLTHEPLACES_ENABLED=true
ALLTHEPLACES_DATASET_PATH=data/external/alltheplaces
ALLTHEPLACES_TIMEOUT_SECONDS=10

# 7. Web Archive Corroboration (Fast Internet Archive CDX + Common Crawl fallback)
WAYBACK_ENABLED=true
COMMONCRAWL_ENABLED=true
COMMONCRAWL_MAX_CHECKS=20
COMMONCRAWL_TIMEOUT_SECONDS=5
COMMONCRAWL_INDEX_URL=https://index.commoncrawl.org/collinfo.json
