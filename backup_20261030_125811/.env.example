# Crawler Identity & Politeness
USER_AGENT=GeographicalLeadScraperPOC/1.0 (contact: research@dakini.ai)
REQUEST_DELAY_SECONDS=1.5
MAX_DISCOVERY_RESULTS=200

# 1. OpenStreetMap Overpass API
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=45
OVERPASS_FALLBACK_URLS=https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter

# 2. Overture Maps (Remote GeoParquet via DuckDB)
OVERTURE_ENABLED=true
OVERTURE_MAX_ROWS=1500
OVERTURE_TIMEOUT_SECONDS=45

# 3. SearXNG Metasearch (Local Docker Service)
SEARXNG_URL=http://localhost:8080
SEARXNG_MAX_REQUESTS=6
SEARXNG_TIMEOUT_SECONDS=10

# 4. Wikidata Query Service & Web API (Public, no API key required)
WIKIDATA_ENABLED=true
WIKIDATA_MAX_SEARCHES=2
WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql
WIKIDATA_API_URL=https://www.wikidata.org/w/api.php
WIKIDATA_TIMEOUT_SECONDS=12

# 5. India Open Government Data: MCA Company Master Data (Optional local dataset)
MCA_ENABLED=false
MCA_DATASET_PATH=data/external/company_master_data.zip

# 6. AllThePlaces (Optional local dataset or published run)
ALLTHEPLACES_ENABLED=true
ALLTHEPLACES_DATASET_PATH=data/external/alltheplaces
ALLTHEPLACES_RUN_URL=https://data.alltheplaces.org/runs/latest/output/
ALLTHEPLACES_TIMEOUT_SECONDS=10

# 7. Common Crawl (Index API domain lookup)
COMMONCRAWL_ENABLED=true
COMMONCRAWL_MAX_CHECKS=5
COMMONCRAWL_TIMEOUT_SECONDS=8
COMMONCRAWL_INDEX_URL=https://index.commoncrawl.org/collinfo.json
